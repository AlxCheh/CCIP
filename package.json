{
  "name": "ccip",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "db:generate": "turbo db:generate",
    "db:migrate": "pnpm --filter @ccip/database migrate:deploy",
    "db:seed": "pnpm --filter @ccip/database seed",
    "audit-suite": "node tools/audit/audit-suite.js",
    "audit-suite:fix": "node tools/audit/audit-suite.js --fix",
    "test:audit": "node tools/audit/run-tests.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "js-yaml": "^4.1.1",
    "lint-staged": "^15.4.3",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "fast-uri": ">=3.1.2",
      "esbuild": ">=0.28.1"
    }
  }
}
